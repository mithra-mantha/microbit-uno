d.\nfunction Card(color: number, num: number): Card {\n    return {\n        \"string\": colors[color] + mappings[num],\n        \"color\": color,\n        \"type\": num,\n    }\n}\n// Helper functions\nfunction createCard(): Card {\n    const num = randint(0, mappings.length - 1)\n    const color = randint(0, colors.length - 1)\n    return Card(color, num)\n}\nfunction checkCards(card1: Card, card2: Card): boolean {\n    return card1.type == card2.type || card1.color == card2.color\n}\nfunction findCard(topCard: Card, deck: Card[]): FoundCard | null {\n    for (let i = 0; i < deck.length; i++) {\n        if (checkCards(deck[i], topCard)) {\n            return {\n                newDeck: deck.filter((value, index) => { return index !== i }),\n                index: i,\n                card: deck[i],\n            }\n        }\n    }\n    return null\n}\nfunction print(item: any, itemType: printType): void {\n    if (itemType === \"card\") {\n        basic.showString(item[\"string\"], SCROLL_SPEED)\n    } else if (itemType === \"string\") {\n        basic.showString(item, SCROLL_SPEED)\n    }\n}\nfunction gameOver(botWon: boolean): void {\n    clearScreen();\n    if (botWon) {\n        basic.showString(\"The bot won!\", SCROLL_SPEED)\n    } else {\n        basic.showString(\"You won!\", SCROLL_SPEED);\n    }\n    basic.pause(3000);\n    control.reset();\n}\nfunction clearScreen() {\n    led.stopAnimation()\n    basic.clearScreen()\n}\nlet botCards: Card[] = [];\nlet playerCards: Card[] = [];\nlet topCard: Card = createCard();\nlet cardsIndex: number = 0\nfor (let i = 0; i < 7; i++) {\n    playerCards.push(createCard())\n    botCards.push(createCard())\n}\nlet state: stateType = \"playing\";\nfunction gameLoop() {\n    // The bot will play first.\n    if (state === \"playing\") {\n        if (botCards.length === 0) {\n            gameOver(true)\n        } else if (playerCards.length === 0) {\n            gameOver(false)\n        }\n        let card;\n        const botFoundVal = findCard(topCard, botCards);\n        if (botFoundVal) {\n            const newDeck = botFoundVal.newDeck;\n            card = botFoundVal.card;\n            print(card, \"card\");\n            botCards = newDeck;\n            topCard = card;\n            if (botCards.length === 0) {\n                gameOver(true)\n            }\n        } else {\n            botCards.push(createCard());\n            PICK_UP_ICON.showImage(0)\n        }\n        basic.pause(2000);\n        if (card.type < 10) {\n            state = \"selection\";\n        }\n        clearScreen();\n        print(playerCards[cardsIndex], \"card\")\n    }\n}\ninput.onButtonPressed(Button.A, function () {\n    if (state === \"selection\") {\n        if (cardsIndex === 0) {\n            cardsIndex = playerCards.length - 1;\n        } else {\n            cardsIndex--\n        }\n        clearScreen()\n        print(playerCards[cardsIndex], \"card\")\n    }\n});\ninput.onButtonPressed(Button.B, function () {\n    if (state === \"selection\") {\n        if (cardsIndex === playerCards.length - 1) {\n            cardsIndex = 0;\n        } else {\n            cardsIndex++\n        }\n        clearScreen()\n        print(playerCards[cardsIndex], \"card\")\n    }\n});\ninput.onButtonPressed(Button.AB, function () {\n    if (state === \"selection\") {\n        if (checkCards(topCard, playerCards[cardsIndex])) {\n            topCard = playerCards[cardsIndex]\n            playerCards.removeAt(cardsIndex);\n            basic.showIcon(IconNames.Happy);\n            basic.pause(ICON_SHOW_TIME)\n            basic.clearScreen();\n            print(topCard, \"card\")\n            state = \"playing\";\n            cardsIndex = 0;\n        } else {\n            basic.showIcon(IconNames.Sad)\n            basic.pause(ICON_SHOW_TIME);\n            basic.clearScreen();\n            print(playerCards[cardsIndex], \"card\")\n        }\n    }\n});\nlet logoState: logoStateType = \"none\";\ninput.onLogoEvent(TouchButtonEvent.Touched, function () {\n    if (state === \"selection\") {\n        logoState = \"peeking\";\n        clearScreen()\n        print(topCard, \"card\");\n    }\n});\ninput.onLogoEvent(TouchButtonEvent.LongPressed, function () {\n    if (state === \"selection\") {\n        logoState = \"drawing\";\n        playerCards.push(createCard())\n        clearScreen();\n        PICK_UP_ICON.showImage(0)\n        state = \"playing\";\n    }\n});\ninput.onLogoEvent(TouchButtonEvent.Released, function () {\n    if (state === \"selection\") {\n        if (logoState === \"peeking\") {\n            print(playerCards[cardsIndex], \"card\")\n        }\n        logoState = \"none\";\n    }\n});\nbasic.forever(gameLoop)\n","README.md":"","main.py":"mappings = [\n    \"0\",   # Index 0\n    \"1\",   # Index 1\n    \"2\",   # Index 2\n    \"3\",   # Index 3\n    \"4\",   # Index 4\n    \"5\",   # Index 5\n    \"6\",   # Index 6\n    \"7\",   # Index 7\n    \"8\",   # Index 8\n    \"9\",   # Index 9\n    \"/\",   # Index 10 (Skip)\n    \"+2\",  # Index 11\n    \"\\\\\",    # Index 12 (Reverse)\n]\ncolors = [\n    \"red\", \"yellow\", \"green\", \"blue\"\n]\ndef create_card() -> any:\n    num = randint(0, len(mappings))\n    color = randint(0, len(colors))\n    return {\n        \"string\":color + mappings[num],\n        \"color\":color,\n        \"type\":num\n    }\ndef check_cards(card1, card2) -> bool:\n    return (\n        card1[\"type\"] == card2[\"type\"] and card1[\"color\"] == card2[\"color\"]\n    )\ndef find_card(top_card, deck) -> any:\n    deck\nplayer_cards = []\nfor i in range(7):\n    player_cards.push(create_card())","pxt.json":"{\n    \"name\": \"TS Uno\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares