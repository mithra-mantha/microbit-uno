\"/\",\n    \"+2\",\n    \"\\\\\"\n]\nconst colors = [\n    \"R\",\n    \"Y\",\n    \"G\",\n    \"B\"\n]\nconst SCROLL_SPEED = 100\nconst ICON_SHOW_TIME = 500\n// Typescript stuff\ninterface Card {\n    color: number\n    type: number\n    string: string\n}\ninterface FoundCard {\n    newDeck: Card[]\n    index: number\n    card: Card\n}\ntype printType = \"card\" | \"string\";\ntype stateType = \"selection\" | \"playing\";\ntype logoStateType = \"peeking\" | \"drawing\" | \"none\";\n// Factory Function for Card.\nfunction Card(color: number, num: number): Card {\n    return {\n        \"string\": colors[color] + mappings[num],\n        \"color\": color,\n        \"type\": num,\n    }\n}\n// Helper functions\nfunction create_card(): Card {\n    const num = randint(0, mappings.length - 1)\n    const color = randint(0, colors.length - 1)\n    return Card(color, num)\n}\nfunction check_cards(card1: Card, card2: Card): boolean {\n    return card1.type == card2.type || card1.color == card2.color\n}\nfunction find_card(top_card: Card, deck: Card[]): FoundCard | null {\n    for (let i = 0; i < deck.length; i++) {\n        if (check_cards(deck[i], top_card)) {\n            return {\n                newDeck: deck.filter((value, index) => { return index !== i }),\n                index: i,\n                card: deck[i],\n            }\n        }\n    }\n    return null\n}\nfunction print(item: any, itemType: printType): void {\n    if (itemType === \"card\") {\n        basic.showString(item[\"string\"], SCROLL_SPEED)\n    } else if (itemType === \"string\") {\n        basic.showString(item, SCROLL_SPEED)\n    }\n}\nfunction game_over(botWon:boolean):void {\n    if (botWon) {\n        basic.showString(\"The bot won!\", SCROLL_SPEED)\n    } else {\n        basic.showString(\"You won!\", SCROLL_SPEED);\n    }\n    basic.pause(3000);\n    control.reset();\n}\nlet bot_cards: Card[] = [];\nlet player_cards: Card[] = [];\nlet top_card: Card = create_card();\nlet cards_index: number = 0\nfor (let i = 0; i < 7; i++) {\n    player_cards.push(create_card())\n    bot_cards.push(create_card())\n}\nlet state: stateType = \"playing\";\nfunction gameLoop() {\n    // The bot will play first.\n    if (state === \"playing\") {\n        if (bot_cards.length === 0) {\n            game_over(true)\n        } else if (player_cards.length === 0) {\n            game_over(false)\n        }\n        const botFoundVal = find_card(top_card, bot_cards);\n        if (botFoundVal) {\n            const newDeck = botFoundVal.newDeck;\n            const card = botFoundVal.card;\n            print(card, \"card\");\n            bot_cards = newDeck;\n            top_card = card;\n        } else {\n            bot_cards.push(create_card());\n        }\n        basic.pause(2000);\n        state = \"selection\";\n    }\n}\ninput.onButtonPressed(Button.A, function () {\n    if (state === \"selection\") {\n        if (cards_index === 0) {\n            cards_index = player_cards.length - 1;\n        } else {\n            cards_index--\n        }\n        led.stopAnimation()\n        basic.clearScreen();\n        print(player_cards[cards_index], \"card\")\n    }\n});\ninput.onButtonPressed(Button.B, function () {\n    if (state === \"selection\") {\n        if (cards_index === player_cards.length - 1) {\n            cards_index = 0;\n        } else {\n            cards_index++\n        }\n        led.stopAnimation()\n        basic.clearScreen();\n        print(player_cards[cards_index], \"card\")\n    }\n});\ninput.onButtonPressed(Button.AB, function () {\n    if (state === \"selection\") {\n        if (check_cards(top_card, player_cards[cards_index])) {\n            top_card = player_cards[cards_index]\n            player_cards.removeAt(cards_index);\n            basic.showIcon(IconNames.Happy);\n            basic.pause(ICON_SHOW_TIME)\n            basic.clearScreen();\n            print(top_card, \"card\")\n            state = \"playing\";\n            cards_index = 0;\n        } else {\n            basic.showIcon(IconNames.Sad)\n            basic.pause(ICON_SHOW_TIME);\n            basic.clearScreen();\n            print(player_cards[cards_index], \"card\")\n        }\n    }\n});\nlet logoState: logoStateType = \"none\";\ninput.onLogoEvent(TouchButtonEvent.Touched, function () {\n    logoState = \"peeking\";\n    led.stopAnimation();\n    basic.clearScreen();\n    print(top_card, glob)\n});\ninput.onLogoEvent(TouchButtonEvent.LongPressed, function () {\n    logoState = \"drawing\";\n});\ninput.onLogoEvent(TouchButtonEvent.Released, function () {\n    if (logoState === \"peeking\") {\n\n    }\n    logoState = \"none\";\n});\nbasic.forever(gameLoop)","README.md":"","main.py":"mappings = [\n    \"0\",   # Index 0\n    \"1\",   # Index 1\n    \"2\",   # Index 2\n    \"3\",   # Index 3\n    \"4\",   # Index 4\n    \"5\",   # Index 5\n    \"6\",   # Index 6\n    \"7\",   # Index 7\n    \"8\",   # Index 8\n    \"9\",   # Index 9\n    \"/\",   # Index 10 (Skip)\n    \"+2\",  # Index 11\n    \"\\\\\",    # Index 12 (Reverse)\n]\ncolors = [\n    \"red\", \"yellow\", \"green\", \"blue\"\n]\ndef create_card() -> any:\n    num = randint(0, len(mappings))\n    color = randint(0, len(colors))\n    return {\n        \"string\":color + mappings[num],\n        \"color\":color,\n        \"type\":num\n    }\ndef check_cards(card1, card2) -> bool:\n    return (\n        card1[\"type\"] == card2[\"type\"] and card1[\"color\"] == card2[\"color\"]\n    )\ndef find_card(top_card, deck) -> any:\n    deck\nplayer_cards = []\nfor i in range(7):\n    player_cards.push(create_card())","pxt.json":"{\n    \"name\": \"TS Uno\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794438195635,"editorVersion