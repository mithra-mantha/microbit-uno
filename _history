.filter((value, index) => { return index !== i }),\n                index: i,\n                card: deck[i],\n            }\n        }\n    }\n    return null\n}\nfunction print(item: any, itemType: printType): void {\n    if (itemType === \"card\") {\n        basic.showString(item[\"string\"])\n    } else if (itemType === \"string\") {\n        basic.showString(item)\n    }\n}\nlet bot_cards: Card[] = [];\nlet player_cards: Card[] = [];\nlet top_card: Card = create_card();\nlet cards_index: number = 0\nfor (let index = 0; index < 7; index++) {\n    player_cards.push(create_card())\n    bot_cards.push(create_card())\n}\nlet state: stateType = \"playing\";\nwhile (true) {\n    // The bot will play first.\n    if (state === \"playing\") {\n        const botFoundVal = find_card(top_card, bot_cards);\n        if (botFoundVal) {\n            const { newDeck, card } = botFoundVal;\n            print(card, \"card\");\n            bot_cards = newDeck;\n            top_card = card;\n        } else {\n            bot_cards.push(create_card());\n        }\n        basic.pause(2000)\n        state = \"selection\"\n    } else {\n        if (input.buttonIsPressed(Button.AB)) {\n            if (check_cards(top_card, player_cards[cards_index])) {\n                top_card = player_cards[cards_index]\n                player_cards.removeAt(cards_index);\n                basic.showIcon(IconNames.Happy);\n                basic.pause(1000)\n                basic.clearScreen();\n            } else {\n                basic.showIcon(IconNames.Sad)\n                basic.pause(1000);\n                basic.clearScreen();\n            }\n            print(top_card, \"card\")\n        } else if (input.buttonIsPressed(Button.B)) {\n            if (cards_index === player_cards.length - 1) {\n                cards_index = 0;\n            } else {\n                cards_index++\n            }\n        } else if (input.buttonIsPressed(Button.A)) {\n            if (cards_index === 0) {\n                cards_index = player_cards.length - 1;\n            } else {\n                cards_index--\n            }\n        }\n    }\n}","README.md":"","main.py":"mappings = [\n    \"0\",   # Index 0\n    \"1\",   # Index 1\n    \"2\",   # Index 2\n    \"3\",   # Index 3\n    \"4\",   # Index 4\n    \"5\",   # Index 5\n    \"6\",   # Index 6\n    \"7\",   # Index 7\n    \"8\",   # Index 8\n    \"9\",   # Index 9\n    \"/\",   # Index 10 (Skip)\n    \"+2\",  # Index 11\n    \"\\\\\",    # Index 12 (Reverse)\n]\ncolors = [\n    \"red\", \"yellow\", \"green\", \"blue\"\n]\ndef create_card() -> any:\n    num = randint(0, len(mappings))\n    color = randint(0, len(colors))\n    return {\n        \"string\":color + mappings[num],\n        \"color\":color,\n        \"type\":num\n    }\ndef check_cards(card1, card2) -> bool:\n    return (\n        card1[\"type\"] == card2[\"type\"] and card1[\"color\"] == card2[\"color\"]\n    )\ndef find_card(top_card, deck) -> any:\n    deck\nplayer_cards = []\nfor i in range(7):\n    player_cards.push(create_card())","pxt.json":"{\n    \"name\": \"TS Uno\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794425014586,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"GT~0a(x-tC)Z^L|XVv`W\">num</variable><variable id=\"~eiiD-s.E+#?ZtV4v/v}\">mappings</variable><variable id=\"tfOL8.lE6J5Rl_:oA%}F\">color</variable><variable id=\"MSVL@$$X6}rRU=c_PAQV\">colors</variable><variable id=\"{sd*J]}LwL=IDA3U1L.K\">top_card</variable><variable id=\"|v[:3nUF=7A@}+^h6g(d\">player_cards</variable><variable id=\"@L6`s:$mtuwYpsRNJS+3\">bot_cards</variable><variable id=\"(R9XIJ_XpQ_w66:.xvE-\">state</variable>